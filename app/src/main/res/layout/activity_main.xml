<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="SIM 1 par unknown incoming calls block karein"
        android:textAlignment="center" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchBlocking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Block unknown calls on SIM 1"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:lineSpacingExtra="6dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Permissions allow karein" />

    <Button
        android:id="@+id/btnSetDefaultScreeningApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Default call screening app set karein" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Note: SIM 2 par sabhi calls hamesha allowed rahengi, chahe number unknown ho."
        android:textStyle="italic"
        android:textAlignment="center" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- SIM 1 PAGE -->
    <ScrollView
        android:id="@+id/pageSim1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="120dp">

            <include layout="@layout/header_app_logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM 1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textSim1Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:text="Detecting..."
                android:textColor="#AAAAAA"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protection Status"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/textProtectionStatusSim1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Checking..."
                    android:textColor="#4CAF50"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/textProtectionSubtitleSim1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocking Rule"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/cardBlockingRuleSim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/textBlockingRuleTitleSim1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow contacts only"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/textBlockingRuleSubtitleSim1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Only calls from your contacts will be allowed"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Stats row: horizontal, 4 columns -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Blocked\nToday" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textBlockedTodaySim1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#FF5252" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Allowed\nToday" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textAllowedTodaySim1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Spam\nBlocked" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textSpamBlockedSim1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#FFB74D" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Last\nUpdate" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textLastUpdateSim1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--:--" android:textColor="#9575CD" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowViewBlockedSim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📋  View Blocked Calls"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowWhitelistSim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="👥  Whitelist (Allowed Numbers)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="20sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SIM 2 PAGE -->
    <ScrollView
        android:id="@+id/pageSim2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="120dp">

            <include layout="@layout/header_app_logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIM 2"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textSim2Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"
                android:text="Detecting..."
                android:textColor="#AAAAAA"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protection Status"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/textProtectionStatusSim2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Checking..."
                    android:textColor="#4CAF50"
                    android:textSize="24sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/textProtectionSubtitleSim2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocking Rule"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/cardBlockingRuleSim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/textBlockingRuleTitleSim2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow all calls"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/textBlockingRuleSubtitleSim2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Everyone can call through"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Blocked\nToday" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textBlockedTodaySim2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#FF5252" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Allowed\nToday" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textAllowedTodaySim2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Spam\nBlocked" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textSpamBlockedSim2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textColor="#FFB74D" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Last\nUpdate" android:textColor="#AAAAAA" android:textSize="10sp"
                        android:gravity="center" android:maxLines="2"/>
                    <TextView android:id="@+id/textLastUpdateSim2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--:--" android:textColor="#9575CD" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowViewBlockedSim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📋  View Blocked Calls"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowWhitelistSim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="👥  Whitelist (Allowed Numbers)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#666666"
                    android:textSize="20sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SETTINGS PAGE -->
    <ScrollView
        android:id="@+id/pageSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="120dp">

            <include layout="@layout/header_app_logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="6dp"
                android:textColor="#CCCCCC"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnGrantPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Grant permissions"/>

            <Button
                android:id="@+id/btnSetDefaultScreeningApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Set as default call screening app"/>

            <Button
                android:id="@+id/btnSetNotificationTone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:text="Set blocked-call notification tone"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="If SIM cannot be detected"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Some phones cannot identify the SIM slot for a call. This rule applies in that case."
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <Spinner
                android:id="@+id/spinnerFallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_bar"
                android:padding="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Background service status"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/textServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_bar"
                android:padding="14dp"
                android:fontFamily="monospace"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:text="Not started yet"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Debug log (last screened calls)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/textDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tab_bar"
                android:padding="14dp"
                android:fontFamily="monospace"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:text="No calls screened yet."/>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM TAB BAR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_bar"
        android:elevation="12dp"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/tabSim1"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_tab_selected">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_sim"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SIM 1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSim2"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_sim"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SIM 2"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_settings"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
